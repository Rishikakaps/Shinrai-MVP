# Run python -m scripts.configure to create private credentials, then add these settings.
# Copy the exact Supabase Session pooler connection string from Connect.
DATABASE_URL=
CDI_AUTO_MIGRATE=true
CDI_DB_POOL_SIZE=4
CDI_DATA_DIR=data
CDI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# V2: private Google AI Studio key; never put it in browser assets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local test inbox only. Native Mailpit defaults can be overridden here.
CDI_ENABLE_REMINDERS=true
CDI_EMAIL_MODE=test
CDI_SMTP_HOST=127.0.0.1
CDI_SMTP_PORT=11025
CDI_REMINDER_RECIPIENT=analyst@example.test
# Keep all credentials server-side; never commit .env.
NGROK_AUTHTOKEN=
# Optional assigned endpoint, e.g. https://your-account.ngrok-free.app
NGROK_URL=
