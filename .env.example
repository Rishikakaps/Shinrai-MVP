# Run python -m scripts.configure to create private credentials, then add these settings.
# Copy the exact Supabase Session pooler connection string from Connect.
DATABASE_URL=
CDI_AUTO_MIGRATE=true
CDI_DB_POOL_SIZE=4
CDI_DATA_DIR=data
CDI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Keep all credentials server-side; never commit .env.
NGROK_AUTHTOKEN=
# Optional assigned endpoint, e.g. https://your-account.ngrok-free.app
NGROK_URL=
